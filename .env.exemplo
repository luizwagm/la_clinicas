# ==========================================================================
#  Modelo do .env — COPIE para `.env` e preencha. O .env não entra no git.
#
#  Em PRODUÇÃO não se usa este arquivo: as variáveis vêm do systemd, por
#  EnvironmentFile=/etc/laclinicas.env (root:root, chmod 600).
#
#  O sistema inteiro vive no PostgreSQL — não há SQLite neste projeto.
# ==========================================================================

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=laclinicas
PGPASSWORD=troque-esta-senha
PGDATABASE=laclinicas_gestao

# Alternativa: uma URL só, que tem prioridade sobre as variáveis acima.
# DATABASE_URL=postgresql://laclinicas:senha@127.0.0.1:5432/laclinicas_gestao

# Quantas conexões o pool mantém. 10 é folgado para uma clínica inteira.
# PGPOOL_MAX=10

# Porta do servidor (5204 é o padrão do parque local para este projeto)
# PORT=5204

# ==========================================================================
#  CHAVE DOS DADOS SENSÍVEIS (obrigatória)
#  Cifra CPF, RG, endereço, telefone, e-mail, anamnese e prontuário no banco.
#  Gere com:  openssl rand -base64 32
#
#  PERDER ESTA CHAVE TORNA OS DADOS ILEGÍVEIS — nem o backup salva.
#  Guarde uma cópia FORA do servidor, junto dos backups.
# ==========================================================================
DADOS_CHAVE=cole-aqui-32-bytes-em-base64

# Só durante uma troca de chave: mantém a leitura do que foi escrito com a antiga.
# DADOS_CHAVE_ANTERIOR=

# ==========================================================================
#  LA CHAT — o chat da equipe dentro do sistema (opcional)
#
#  Sem `CHAT_SEGREDO_PASSE` o conector fica INATIVO, avisa no boot e as rotas
#  do chat somem. O resto do sistema não muda de comportamento.
#
#  O segredo é o MESMO dos dois lados: aqui e no `/etc/lachat-<instancia>.env`
#  do serviço do chat. Gere com:  openssl rand -base64 32
#
#  ATENÇÃO ao nginx em produção: o WebSocket exige o bloco
#  `location /restrito/chat/ws` e o `map` de upgrade em conf.d. Sem eles o
#  chat autentica e nunca recebe mensagem em tempo real, sem erro visível.
# ==========================================================================
CHAT_URL=http://127.0.0.1:5197
CHAT_SEGREDO_PASSE=
