# ==========================================================================
#  Fim de linha
#
#  O `core.autocrlf` da máquina de desenvolvimento está ligado (Windows). Sem
#  estas regras, todo `.sh` que chegasse ao servidor levaria o `\r` junto, e o
#  bash lê o `\r` como parte do comando: `fi\r` vira erro de sintaxe numa
#  linha que parece perfeita no editor. Estes tipos NASCEM e FICAM com LF.
# ==========================================================================
* text=auto

*.sh       text eol=lf
*.service  text eol=lf
*.conf     text eol=lf
*.sql      text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
